
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Character {
  id String @id @default(uuid())
  name String
  url String
  position_x Float
  position_y Float
  wallpaper Wallpaper @relation(fields: [wallpaperId], references: [id])
  wallpaperId String
  
}

model Wallpaper {
  id String @id @default(uuid())
  url String
  name String
  characters Character[]
}


